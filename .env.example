# Base URL da API pública usada nos testes
API_BASE_URL=https://dummyjson.com

# Credenciais de demonstração PUBLICADAS pela própria DummyJSON na documentação oficial
# (https://dummyjson.com/docs/auth) — não são segredo, servem só para gerar um token de teste.
# O token é obtido automaticamente no início de cada execução (GlobalSetup).
AUTH_USERNAME=emilys
AUTH_PASSWORD=emilyspass
